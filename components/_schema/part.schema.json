{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "altium-claude-kit part record",
  "type": "object",
  "required": ["id", "mfr", "category", "package", "status", "datasheet"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "mfr": {"type": "string", "minLength": 1},
    "category": {"type": "string", "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$"},
    "package": {"type": "string"},
    "status": {"enum": ["extracted_unreviewed", "verified", "conflicting", "stale"]},
    "datasheet": {"type": "object", "properties": {"rev": {"type": "string"}, "url": {"type": "string"}}},
    "description": {"type": "string"},
    "selection": {"type": "object"},
    "abs_max": {"type": "object"},
    "recommended": {"type": "object"},
    "pins": {
      "type": "array",
      "items": {"type": "object", "required": ["num", "name"],
                "properties": {"num": {"type": ["string", "integer"]}, "name": {"type": "string"},
                               "type": {"type": "string"}, "fn": {"type": "string"}, "ref": {"type": "string"}}}
    },
    "application": {"type": "object"},
    "layout": {"type": "array"},
    "thermal": {"type": "object"},
    "cad": {"type": "object"},
    "gaps": {"type": "array"}
  }
}
