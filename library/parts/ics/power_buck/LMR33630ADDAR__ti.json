 "notes": {
  "application": [
   {
    "text": "Feedback: VREF nominally 1 V; RFBB from Equation 3. TI's 5 V / 400 kHz example uses RFBT 100 k and RFBB 24.9 k.",
    "ref": {
     "page": 21,
     "quote": "For this 5-V example, RFBT = 100 kΩ and RFBB = 24.9 kΩ are chosen.",
     "mode": "raw"
    }
   },
   {
    "text": "Inductor ripple current: choose 20 % to 40 % of the maximum output current (30 % suggested); use the device maximum current when the load is much lower.",
    "ref": {
     "page": 21,
     "quote": "range of 20% to 40%",
     "mode": "raw"
    }
   },
   {
    "text": "Inductor ripple must stay above about 10 % of the device maximum rated current.",
    "ref": {
     "page": 22,
     "quote": "minimum inductor ripple current must be no less than about 10% of the device maximum rated current",
     "mode": "raw"
    }
   },
   {
    "text": "Input: at least 10 uF of ceramic capacitance, plus a small ceramic as close to the device as possible.",
    "ref": {
     "page": 23,
     "quote": "A minimum of 10 µF of ceramic capacitance is required",
     "mode": "raw"
    }
   },
   {
    "text": "Typical components for 5 V / 400 kHz: L 8 uH, COUT 4 x 22 uF, RFBT 100 k, RFBB 24.9 k, CIN 10 uF + 220 nF, CBOOT 100 nF, CVCC 1 uF, CFF open.",
    "ref": {
     "page": 20,
     "quote": "400 5 8 4 × 22 µF 100 k 24.9 k 10 µF + 220 nF 100 nF 1 µF open",
     "mode": "raw"
    }
   },
   {
    "text": "Use effective capacitance (after DC bias and temperature), low-ESR ceramics, X5R or better.",
    "ref": {
     "page": 19,
     "quote": "Use high-quality, low-ESR, ceramic",
     "mode": "raw"
    }
   }
  ],
  "layout": [
   {
    "text": "Input-capacitor / PGND loop is the most critical: wide, short traces, smallest loop area.",
    "ref": {
     "page": 33,
     "quote": "the most critical PCB feature is the loop formed by the input capacitor or input capacitors, and power ground",
     "mode": "raw"
    }
   },
   {
    "text": "Input capacitor(s) as close as possible to VIN and GND; VCC capacitor close to VCC; CBOOT close with short wide traces to BOOT and SW.",
    "ref": {
     "page": 33,
     "quote": "Place the input capacitor or capacitors as close as possible to the VIN and GND terminals.",
     "mode": "raw"
    }
   },
   {
    "text": "Feedback divider close to FB; keep the VOUT sense trace away from SW.",
    "ref": {
     "page": 33,
     "quote": "Place the feedback divider as close as possible to the FB pin of the device.",
     "mode": "raw"
    }
   },
   {
    "text": "Solder the thermal pad to the ground plane; array of thermal vias to the bottom plane; 2 oz outer copper recommended (no less than 1 oz).",
    "ref": {
     "page": 33,
     "quote": "Connect the thermal pad to the ground plane.",
     "mode": "raw"
    }
   },
   {
    "text": "Keep the SW node area small and short/wide to the inductor (radiated EMI).",
    "ref": {
     "page": 33,
     "quote": "Keep switch area small.",
     "mode": "raw"
    }
   }
  ]
 },
